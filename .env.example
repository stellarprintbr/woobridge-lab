# Supabase — server-only, nunca exponha com prefixo NEXT_PUBLIC_
# URL do projeto (Project Settings → API → Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# service_role key (Project Settings → API → service_role secret)
# Bypassa RLS — é assim que as rotas do Next.js acessam os dados no servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
